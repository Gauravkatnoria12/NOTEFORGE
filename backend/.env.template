# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/noteforge

# SMTP Email Configuration (Gmail recommended)
SMTP_EMAIL=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password
SMTP_SENDER=your-verified-sender-email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_TLS=True
SMTP_START_TLS=False

# JWT Token Secret (Min 32 random characters recommended)
JWT_SECRET=your_jwt_secret_key_change_me_to_something_secure

# Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Brevo Email API Key (for cloud deployments — bypasses SMTP port blocks)
# Get yours at: https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=your_brevo_api_key_here
# Frontend URL for CORS configuration (FastAPI)
# Support multiple comma-separated URLs
FRONTEND_URL=http://localhost:5173

# Cookie security settings (Set to secure=True, samesite=none for cross-origin deployments)
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
